# Copy to .env next to docker-compose.yml, then `chmod 600 .env`.
# NEVER commit this file; it holds the Skylit password.

# Public address users open in a browser. Must match exactly (scheme + host,
# plus :port only if it is not the default for the scheme).
PUBLIC_ORIGIN=https://skylit.example.com

# Keep true whenever PUBLIC_ORIGIN is https.
COOKIE_SECURE=true

# Required by the gateway as an admin bearer; generate with:
#   openssl rand -hex 32
GATEWAY_ACCESS_TOKEN=

# Skylit sign-in used by the session sidecar.
SKYLIT_ACCOUNT=
SKYLIT_PASSWORD=
